#!/bin/sh
# dekyon-codex . run Codex, then journal the session.
#
# Current Codex builds expose SessionEnd directly. This wrapper remains a
# fallback for older builds and non-interactive modes that do not dispatch
# lifecycle hooks reliably. It runs codex with your arguments and, when the
# process exits, asks the dekyon worker to find the newest rollout whose
# session metadata matches this working directory.
#
# Use it instead of `codex` (alias codex=dekyon-codex), or alongside the
# hook-based capture installed by `install.py --codex`; the note is keyed by
# session id either way, so both paths converge on one file.

[ -n "$DEKYON_ACTIVE" ] && exec codex "$@"

codex "$@"
rc=$?

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WORKER="$DIR/../scripts/dekyon_worker.py"
if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
else
    PYTHON=python
fi

if [ -f "$WORKER" ]; then
    # Detach so the note is written even if the terminal closes right after
    # codex exits: prefer setsid, fall back to nohup, then a bare background job.
    payload=$("$PYTHON" -c 'import json,sys; print(json.dumps({"session_id":"", "transcript_path":"", "cwd":sys.argv[1], "reason":"codex-exit", "source":"codex"}))' "$PWD")
    if command -v setsid >/dev/null 2>&1; then
        printf '%s' "$payload" | DEKYON_ACTIVE=1 setsid "$PYTHON" "$WORKER" --stdin >/dev/null 2>&1 &
    elif command -v nohup >/dev/null 2>&1; then
        printf '%s' "$payload" | DEKYON_ACTIVE=1 nohup "$PYTHON" "$WORKER" --stdin >/dev/null 2>&1 &
    else
        printf '%s' "$payload" | DEKYON_ACTIVE=1 "$PYTHON" "$WORKER" --stdin >/dev/null 2>&1 &
    fi
fi

exit $rc
